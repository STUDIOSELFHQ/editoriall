<%= render layout: "shared/auth", locals: { kicker: "Reset", title: "Update your password" } do %>
  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <div class="mt-6">
      <%= form.label :password, "New password", class: "kicker" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "field" %>
    </div>
    <div class="mt-5">
      <%= form.label :password_confirmation, "Repeat password", class: "kicker" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "field" %>
    </div>
    <div class="mt-8">
      <%= form.submit "Save", class: "btn" %>
    </div>
  <% end %>
<% end %>
