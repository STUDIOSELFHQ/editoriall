<%= render layout: "shared/auth", locals: { kicker: "Reset", title: "Forgot your password?" } do %>
  <%= form_with url: passwords_path do |form| %>
    <div class="mt-6">
      <%= form.label :email_address, "Email", class: "kicker" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "field" %>
    </div>
    <div class="mt-8">
      <%= form.submit "Email reset instructions", class: "btn" %>
    </div>
  <% end %>
<% end %>
