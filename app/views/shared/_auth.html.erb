<div class="mx-auto flex min-h-dvh max-w-lg flex-col justify-center px-5 py-12">
  <%= link_to root_path, class: "self-start" do %>
    <p class="kicker">Editoriall</p>
    <p class="wordmark mt-1 text-2xl"><%= wordmark(link: false) %></p>
  <% end %>
