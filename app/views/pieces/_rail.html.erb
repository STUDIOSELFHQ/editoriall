<section class="rail-section">
  <p class="kicker">Masthead</p>
  <ul class="mt-3">
    <% @seats.sort_by { |seat| [seat.agent? ? 1 : 0, seat.seatable.actor_name] }.each do |seat| %>
      <li class="flex items-center gap-2 py-1">
        <%= actor_initials(seat.seatable) %>
        <div class="min-w-0">
          <p class="truncate text-sm"><%= seat.seatable.actor_name %></p>
          <p class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ink-soft">
            <%= seat.seatable == @piece.chair ? "chair" : (seat.agent? ? seat.seatable.role_title : seat.role) %>
          </p>
        </div>
      </li>
    <% end %>
  </ul>
</section>

<section class="rail-section">
  <p class="kicker">Mark the copy</p>
  <%= form_with model: [@piece, Mark.new], id: "new_mark", class: "mt-3", data: { copy_target: "markForm" } do |form| %>
    <%= form.label :quote, "Quote", class: "kicker" %>
    <%= form.text_area :quote, class: "field min-h-16 text-sm", data: { copy_target: "quote" }, placeholder: "Select lines in the copy" %>
    <%= form.label :body, "Note", class: "kicker mt-3" %>
    <%= form.text_area :body, required: true, class: "field min-h-20 text-sm", placeholder: "What should change" %>
    <div class="mt-3">
      <%= form.submit "File mark", class: "btn btn-mark" %>
    </div>
  <% end %>
  <div id="marks">
    <%= render @marks %>
  </div>
</section>

<section class="rail-section">
  <p class="kicker">Send a pass</p>
  <% if @desk.agents.any? %>
    <%= form_with model: [@piece, Pass.new], class: "mt-3" do |form| %>
      <%= form.label :agent_id, "Agent", class: "kicker" %>
      <%= form.select :agent_id, @desk.agents.map { |agent| [agent.label, agent.id] }, {}, class: "field" %>
      <%= form.label :brief, "Assignment", class: "kicker mt-3" %>
      <%= form.text_area :brief, class: "field min-h-20 text-sm", placeholder: "Tighten the lede. Cut the third section. Don't add facts." %>
      <div class="mt-3">
        <%= form.submit "Send", class: "btn" %>
      </div>
    <% end %>
    <% unless xai_configured? %>
      <p class="mt-3 text-sm text-mark">Set XAI_API_KEY to let agents return a pass.</p>
    <% end %>
  <% else %>
    <p class="mt-3 text-sm text-ink-soft">Hire an agent on the desk first.</p>
  <% end %>
  <div id="passes">
    <%= render @passes %>
  </div>
</section>

<section class="rail-section">
  <p class="kicker">Log</p>
  <div id="activities">
    <% @activities.each do |activity| %>
      <p class="activity-row text-sm">
        <span class="font-medium"><%= activity.actor.actor_name %></span>
        <%= activity.phrase %>
        <span class="block font-mono text-[0.62rem] uppercase tracking-[0.1em] text-ink-soft"><%= relative_time(activity.created_at) %></span>
      </p>
    <% end %>
  </div>
</section>
