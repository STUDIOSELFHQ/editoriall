<%= render layout: "shared/auth", locals: { kicker: "Masthead", title: "Sign in" } do %>
  <%= form_with url: session_path do |form| %>
    <div class="mt-6">
      <%= form.label :email_address, "Email", class: "kicker" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "field" %>
    </div>
    <div class="mt-5">
      <%= form.label :password, class: "kicker" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "field" %>
    </div>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <%= form.submit "Enter", class: "btn" %>
      <%= link_to "Forgot password?", new_password_path, class: "font-mono text-[0.72rem] uppercase tracking-[0.12em] text-ink-soft" %>
    </div>
  <% end %>
  <p class="mt-8 font-mono text-[0.72rem] uppercase tracking-[0.12em] text-ink-soft">
    New to the desk? <%= link_to "Sit down", new_registration_path, class: "text-ink" %>
  </p>
<% end %>
