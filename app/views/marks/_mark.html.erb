<div id="<%= dom_id(mark) %>" class="mark-card">
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-2">
      <%= actor_initials(mark.actor) %>
      <div>
        <p class="text-sm font-medium"><%= mark.actor.actor_name %></p>
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ink-soft"><%= mark.status %> · <%= relative_time(mark.created_at) %></p>
      </div>
    </div>
    <% if mark.open? && (mark.piece.in_chair?(current_user) || mark.actor == current_user) %>
      <%= button_to "Resolve", piece_mark_path(mark.piece, mark), method: :patch, class: "link-button font-mono text-[0.62rem] uppercase tracking-[0.12em] text-mark" %>
    <% end %>
  </div>
  <% if mark.quote.present? %>
    <p class="quote text-sm"><%= mark.quote %></p>
  <% end %>
  <p class="mt-2 text-sm leading-relaxed"><%= mark.body %></p>
</div>
