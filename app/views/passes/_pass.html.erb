<div id="<%= dom_id(pass) %>" class="pass-card">
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-2">
      <%= actor_initials(pass.agent) %>
      <div>
        <p class="text-sm font-medium"><%= pass.agent.name %></p>
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ink-soft"><%= pass.status %> · <%= relative_time(pass.created_at) %></p>
      </div>
    </div>
  </div>
  <% if pass.brief.present? %>
    <p class="mt-2 text-sm italic text-ink-soft"><%= pass.brief %></p>
  <% end %>
  <% if pass.summary.present? %>
    <p class="mt-2 text-sm leading-relaxed"><%= pass.summary %></p>
  <% end %>
  <% if pass.error_message.present? %>
    <p class="mt-2 text-sm text-mark"><%= pass.error_message %></p>
  <% end %>
  <% if pass.ready? %>
    <div class="mt-3 flex flex-wrap gap-2">
      <%= link_to "Read pass", piece_path(pass.piece, pass_id: pass.id), class: "btn btn-ghost", data: { turbo_frame: "_top" } %>
      <%= button_to "Apply", apply_piece_pass_path(pass.piece, pass), class: "btn" %>
      <%= button_to "Kill", reject_piece_pass_path(pass.piece, pass), class: "btn btn-ghost" %>
    </div>
  <% elsif pass.in_flight? %>
    <p class="mt-2 font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ink-soft">On the copy now…</p>
  <% end %>
</div>
